# lodeline-manager environment configuration
# ============================================
# Copy this file to `.env` and replace every placeholder. The binary reads
# these variables from the process environment and does not load `.env`
# itself; how you populate the env (direnv, systemd EnvironmentFile,
# docker --env-file, dotenv-cli, etc.) is your choice.
#
# Reference: docs/specs/fleet-api/contract.md §F2 (auth),
#            apps/manager/docs/specs/2026-05-16-ui-ux-design.md §9 (single admin).
#
# src/config.rs checks them at start; the process refuses to start if any
# required var is unset or any var is invalid.

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# HTTP listen address. Optional, default ":8080".
# LISTEN_ADDR=:8080

# Reverse proxies whose X-Forwarded-For the login limiter reads: a comma-separated
# list of IP addresses and CIDR networks. Optional, default empty: the limiter
# keys on the connection's peer address and ignores forwarding headers. Behind a
# proxy, list its address here (127.0.0.1 for a proxy on the same host), or every
# client shares the proxy's 10 attempts a minute. The client is the rightmost
# X-Forwarded-For hop that is not a listed proxy, so each proxy must append the
# client's address to the header. nginx needs
#   proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
# and Caddy's reverse_proxy does it by default. A request without the header
# counts for the proxy itself. Write IPv4 entries in plain form: a ::ffff: entry
# never matches. Never list 0.0.0.0/0 or ::/0, which would let any client name
# its own address. See README.md, "Behind a reverse proxy".
# TRUSTED_PROXIES=192.0.2.10,198.51.100.0/24

# -----------------------------------------------------------------------------
# Fleet client (consumes Ju571nK/lodeline lodeline-server)
# -----------------------------------------------------------------------------

# Base URL of the lodeline-server `/v1/*` API. Required UNLESS MOCK_FLEET=1.
# No trailing slash. lodeline-server serves everything on one port (default 8443).
LODELINE_SERVER_BASE_URL=https://localhost:8443

# Bearer token lodeline-server validates per contract F2. Required UNLESS MOCK_FLEET=1.
# Generate / rotate on the lodeline-server side via the LODELINE_SERVER_READ_TOKEN env
# var on THAT process. Both sides must agree.
LODELINE_SERVER_READ_TOKEN=replace-with-your-shared-secret

# mTLS to lodeline-server. A lodeline-server with client_ca_path set refuses any
# connection without a client certificate signed by that CA, so give the
# manager one (issue it like an agent host's client cert). The CA path is the
# CA that signed the server certificate; omit it to use the system roots.
# Cert and key must be set together. Any of these requires an https:// base URL.
# Optional; unset = plain HTTP or system-trusted HTTPS as before.
# LODELINE_SERVER_CA_PATH=/etc/lodeline-manager/lodeline-ca.crt
# LODELINE_SERVER_CLIENT_CERT_PATH=/etc/lodeline-manager/client.crt
# LODELINE_SERVER_CLIENT_KEY_PATH=/etc/lodeline-manager/client.key

# Set to "1" to skip the HTTP FleetClient and use an in-process Mock with
# deterministic fixtures. Useful for local dev without a running lodeline-server.
# Optional, default "0".
# MOCK_FLEET=0

# -----------------------------------------------------------------------------
# Triage state (lodeline-manager-owned SQLite per UI/UX D5)
# -----------------------------------------------------------------------------

# Path to the SQLite database file holding ack/assign/resolve/notes state.
# Optional, default "./var/triage.sqlite". The directory MUST be writable.
# TRIAGE_DB_PATH=./var/triage.sqlite

# -----------------------------------------------------------------------------
# Single-admin auth (UI/UX §9)
# -----------------------------------------------------------------------------

# Login username for the single admin. Required.
ADMIN_USERNAME=admin

# Bcrypt hash of the admin password. Required.
#
# Must start with "$2a$", "$2b$", or "$2y$" and be 60 chars long.
# The default below is the bcrypt hash of "change-me-on-first-boot" — REPLACE
# IT BEFORE EXPOSING THE CONSOLE TO ANYTHING.
#
# Generate a new hash with:
#   htpasswd -bnBC 10 '' 'your-password' | tr -d ':\n'
# or:
#   docker run --rm pajlada/bcrypt-cli 'your-password'
ADMIN_PASSWORD_BCRYPT=$2a$10$55LlvKwbVdEZOVEdFBFshuFyd1fqHDSKTTXgK5L890cxNNZxATtg2

# -----------------------------------------------------------------------------
# JWT session
# -----------------------------------------------------------------------------

# Secret used to HS256-sign session JWTs. Required.
#
# Must be at least 32 bytes (256 bits). Generate one with:
#   openssl rand -base64 32
# Keep it secret — anyone who knows it can forge sessions.
JWT_SECRET=replace-this-with-a-32-byte-or-longer-secret

# Session lifetime in hours. Optional, default 12 (per UI/UX §9).
# JWT_TTL_HOURS=12

# Local-dev only: set to "1" to clear the Secure flag on the session cookie
# so it survives over plain http://. Defaults to Secure=true in production.
# DO NOT set this in any environment reachable from the internet.
# LODELINE_INSECURE_COOKIE=0

# -----------------------------------------------------------------------------
# SPA hints (informational; surfaced via /api/v1/meta)
# -----------------------------------------------------------------------------

# How often the SPA polls /api/v1/fleet/events while the Alerts queue is
# visible (UI/UX §7.2). Optional, default 5. Also used as the fleet read
# cache's freshness TTL (see below).
# FLEET_POLL_INTERVAL_SECONDS=5

# -----------------------------------------------------------------------------
# Fleet read cache
# -----------------------------------------------------------------------------
#
# lodeline-manager caches lodeline-server read responses in-process so that N
# concurrent dashboard clients do not multiply onto the upstream. The cache is
# stale-while-revalidate with single-flight: entries are fresh for
# FLEET_POLL_INTERVAL_SECONDS, served stale (and refreshed in the background)
# for up to 12× that, and degrade to the last-known-good value if lodeline-server
# is briefly unavailable. /v1/healthz is never cached. Triage state is joined
# after the cache, so it is always live.

# Set to "1" to disable the cache entirely (pass-through to lodeline-server on
# every request). Optional, default "0". A safe kill-switch.
# FLEET_CACHE_DISABLED=0

# Maximum number of distinct cached (endpoint + filter) keys. Oldest entries
# are evicted past this bound. Optional, default 512.
# FLEET_CACHE_MAX_ENTRIES=512

# -----------------------------------------------------------------------------
# Optional organization login: one generic OIDC provider (local admin retained)
# -----------------------------------------------------------------------------
# Leave ALL variables below unset to disable OIDC. When enabled, all five are
# required. HTTPS is required for issuer, discovered endpoints and callback.
# The issuer must match discovery exactly (use a specific Entra tenant/realm).
# OIDC_ISSUER_URL=https://identity.example.com/realms/company
# OIDC_CLIENT_ID=lodeline-manager
# OIDC_CLIENT_SECRET=replace-with-provider-client-secret
# OIDC_REDIRECT_URL=https://lodeline.example.com/api/v1/auth/oidc/callback
# JSON array of exact ID-token `sub` values for admitted console operators.
# Every admitted subject has full console permissions; emails/groups are not IDs.
# OIDC_ALLOWED_SUBJECTS=["provider-subject-1"]
# See docs/operations/oidc.md for setup, recovery and session limitations.
