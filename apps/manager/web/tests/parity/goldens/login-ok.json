{
  "request": {
    "method": "POST",
    "path": "/api/v1/auth/login",
    "server": "mock"
  },
  "status": 200,
  "headers": {
    "content-type": "application/json",
    "content-security-policy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'",
    "x-frame-options": "DENY",
    "x-content-type-options": "nosniff",
    "referrer-policy": "no-referrer"
  },
  "cookies": [
    {
      "name": "lodeline_session",
      "value": "<set>",
      "attributes": {
        "path": "/",
        "expires": "<now+87600h http-date>",
        "max-age": "315360000",
        "httponly": true,
        "samesite": "Lax"
      }
    }
  ],
  "body": {
    "expires_at": "<now+87600h .fZ>",
    "username": "admin"
  }
}
