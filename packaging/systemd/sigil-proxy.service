# Sigil Proxy — systemd unit (Linux).
#
# Installed DISABLED by the .deb / .rpm packages to
# /usr/lib/systemd/system/sigil-proxy.service. No live config is shipped:
# copy /etc/sigil/proxy.yaml.example to /etc/sigil/proxy.yaml, edit it, create
# the referenced certificate/key/secret files (private files owned by the
# sigil-proxy user, mode 0600), run `sigil-proxy check-config`, then enable.
#
# SELinux: the sigil-proxy domain is deferred to hardware verification; until
# then the daemon runs unconfined.

[Unit]
Description=Sigil Proxy — standalone MCP relay with audit
Documentation=https://github.com/Ju571nK/sigil
# Spool expiry uses the wall clock, so start after the clock is synced.
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=simple
# --config is required: the binary has no default path or auto-discovery.
ExecStart=/usr/bin/sigil-proxy run --config /etc/sigil/proxy.yaml
Restart=on-failure
RestartSec=5
# SIGTERM starts a graceful drain (limits.shutdown_grace_secs, default 30 s).
# TimeoutStopSec = grace + margin so systemd does not SIGKILL mid-drain.
KillSignal=SIGTERM
TimeoutStopSec=45
# Exit 2 = invalid config: do not restart-loop on it.
RestartPreventExitStatus=2
User=sigil-proxy
Group=sigil-proxy
# Separate state directory: never shared with the agent, sender or server.
# Matches state_dir in proxy.yaml.example (/var/lib/sigil-proxy).
StateDirectory=sigil-proxy
LogsDirectory=sigil-proxy
StateDirectoryMode=0750
LogsDirectoryMode=0750
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/sigil-proxy /var/log/sigil-proxy
ProtectHome=read-only
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
