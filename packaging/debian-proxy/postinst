#!/bin/sh
set -e

#DEBHELPER#

# Lodeline hardening (#10 slice 2): create the lodeline-proxy group/user so the proxy
# unit's User=lodeline-proxy resolves before start. Guarded so non-systemd hosts no-op.
# Idempotent (sysusers is declarative; a no-op if the group/user already exist).
if command -v systemd-sysusers >/dev/null 2>&1; then
    systemd-sysusers /usr/lib/sysusers.d/lodeline-proxy.conf >/dev/null 2>&1 || true
fi
/usr/libexec/lodeline-proxy/migrate-from-sigil proxy || true

exit 0
