#!/bin/sh
set -e

#DEBHELPER#

# Lodeline hardening (#61): a standalone sender install must create the lodeline
# group/user + own the dirs so the unit's Group=lodeline resolves before start.
# Guarded so non-systemd hosts no-op. Idempotent (sysusers/tmpfiles are
# declarative; a no-op when the agent package already created them).
if command -v systemd-sysusers >/dev/null 2>&1; then
    systemd-sysusers /usr/lib/sysusers.d/lodeline-sender.conf >/dev/null 2>&1 || true
fi
/usr/libexec/lodeline-sender/migrate-from-sigil sender || true
if command -v systemd-tmpfiles >/dev/null 2>&1; then
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/lodeline-sender.conf >/dev/null 2>&1 || true
fi

exit 0
